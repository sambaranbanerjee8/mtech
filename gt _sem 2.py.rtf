import numpy as np

def mixed_strategy_nash(A, B):
    """
    Find mixed strategy Nash equilibrium for 2x2 games

    A = payoff matrix for Player A
    B = payoff matrix for Player B
    """

    # Probability q that Player B plays strategy 1
    denominator_q = (A[0][0] - A[0][1] - A[1][0] + A[1][1])

    if denominator_q == 0:
        print("No unique mixed equilibrium for Player B")
        return

    q = (A[1][1] - A[0][1]) / denominator_q

    # Probability p that Player A plays strategy 1
    denominator_p = (B[0][0] - B[1][0] - B[0][1] + B[1][1])

    if denominator_p == 0:
        print("No unique mixed equilibrium for Player A")
        return

    p = (B[1][1] - B[1][0]) / denominator_p

    print("Mixed Strategy Nash Equilibrium:")
    print(f"Player A:")
    print(f"  Strategy1 = {p:.3f}")
    print(f"  Strategy2 = {1-p:.3f}")

    print(f"\nPlayer B:")
    print(f"  Strategy1 = {q:.3f}")
    print(f"  Strategy2 = {1-q:.3f}")

    return p, q


# Example: Matching Pennies Game

A = np.array([
    [1, -1],
    [-1, 1]
])

B = np.array([
    [-1, 1],
    [1, -1]
])

mixed_strategy_nash(A, B)
